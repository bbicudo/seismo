# Copiado para .env pelo infra/scripts/init-env.sh. Nada secreto aqui:
# a senha do Postgres fica em secrets/postgres_password e o basic auth em infra/caddy/auth.caddy.

# --- ambiente ---
SEISMO_ENV=lab
SEISMO_TAG=dev
REGISTRY=local                      # na VPS, com CI: ghcr.io/<usuario-github>

# --- endereço público (Caddy) ---
SITE_ADDRESS=seismo.example.com      # domínio do site (o Caddy emite o HTTPS sozinho)

# --- coletor ---
SEISMO_PAUSED=1                     # 1 = começa pausado; liberar com infra/scripts/seismo.sh resume
SEISMO_WORLDS=all                   # "all" ou lista separada por vírgula (ex.: Venebra,Antica)
SEISMO_CONTACT=                     # e-mail de contato do projeto (vai no User-Agent)
SEISMO_PUBLIC_CONTACT=              # e-mail mostrado na página de privacidade (deixe vazio para não mostrar)
TIBIADATA_BASE=https://api.tibiadata.com/v4
COLLECT_INTERVAL_SECONDS=300        # foto de online a cada 5 min
MAX_CONCURRENCY=2                   # pedidos simultâneos à TibiaData
MAX_RPS=2                           # teto de pedidos por segundo

# --- Postgres (ajuste para a RAM da máquina) ---
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_MEM_LIMIT=4g

# --- backup ---
BACKUP_DIR=/var/backups/seismo
BACKUP_KEEP_DAYS=7
BACKUP_MIN_FREE_GB=8                # não faz dump se o disco tiver menos que isso livre
